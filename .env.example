# Copy to .env.local and fill in from your Supabase project's Settings -> API page.
# .env.local is gitignored - never commit real values.
#
# VITE_SUPABASE_PUBLISHABLE_KEY is the "publishable" key (client-safe, RLS-gated).
# Never put the "secret" key (sb_secret_...) here or anywhere in src/ - it bypasses RLS.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
